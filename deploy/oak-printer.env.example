# Настройки службы oak-printer (копируется в ~/.config/oak-printer.env)

# COM-порт анализатора (USB-COM переходник). Надёжнее указать постоянное имя
# из `ls -l /dev/serial/by-id/` — оно не меняется при переподключении.
DEVICE=/dev/ttyUSB0

# Очередь CUPS (lpstat -p). Пусто — принтер по умолчанию.
PRINTER=LBP6000-LBP6018
